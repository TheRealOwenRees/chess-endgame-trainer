# /etc/chesstrainer/backup.env -- root:root, mode 0600.
#
# Sourced by /usr/local/sbin/chesstrainer-backup. Every value below shows the
# default; only AGE_RECIPIENT and HEALTHCHECK_URL must be set. Keep secrets out
# of the repo and out of world-readable files.

# age public key, generated on the workstation with `age-keygen`.
# The private key never leaves the workstation.
AGE_RECIPIENT=age1...

# healthchecks.io (or compatible) ping URL. The script pings it after a good
# run and pings <url>/fail after a bad one. Set SKIP_HEARTBEAT=1 to run without
# monitoring (testing only).
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Refuse to dump when the filesystem has less than this much free space.
MIN_FREE_MB=2048

# Retention. Dumps and their globals/counts/checksum siblings disappear as a
# set; only the encrypted archives in offsite/ live for the longer window.
LOCAL_PLAINTEXT_DAYS=3
LOCAL_ENCRYPTED_DAYS=14
PREDEPLOY_KEEP=5

# Postgres coordinates. The container trusts local Unix-socket connections, so
# no password belongs here.
DB_CONTAINER=chesstrainer-db
PG_USER=chesstrainer
PG_DB=chesstrainer_prod
BACKUP_DIR=/var/backups/chesstrainer

# Roles the globals dump must be able to recreate.
EXPECTED_ROLES="chesstrainer chesstrainer_ro"
