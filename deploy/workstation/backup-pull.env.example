# ~/.config/chesstrainer/backup-pull.env -- mode 0600.
#
# Sourced by ~/.local/bin/chesstrainer-backup-pull. Values below are the
# defaults; VPS_HOST and AGE_KEY must be right. Quote anything containing
# spaces.

VPS_HOST=owen@159.69.21.225
REMOTE_DIR=/var/backups/chesstrainer/offsite
DEST="/mnt/Mint Data/chesstrainer-backups"

# Private half of the age key. Back this file up somewhere safe: without it
# every archive is unreadable.
AGE_KEY="$HOME/.config/chesstrainer/age.key"

# Fail the pull when the newest archive from the VPS is older than this, which
# means the VPS backup timer has stopped.
MAX_STALENESS_HOURS=48

# Keep every archive from the last 7 days, then one per ISO week for 4 weeks,
# then one per calendar month for 6 months.
KEEP_DAILY_DAYS=7
KEEP_WEEKLY_WEEKS=4
KEEP_MONTHLY_MONTHS=6

# Restore drill. It runs in a throwaway container matching the production
# Postgres major and appends results to DRILL_LOG.
# DRILL_IMAGE=postgres:18.6
# DRILL_DB=chesstrainer_restore
# DRILL_LOG="$DEST/drills.log"
EXPECTED_ROLES="chesstrainer chesstrainer_ro"

# Optional second heartbeat check with a long period (for example 72h), so you
# hear about it when the workstation stops pulling. Leave empty to disable.
# PULL_HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Extra ssh options, space separated.
# SSH_OPTIONS="-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15"
