# /etc/chesstrainer/probe.env -- root:root, mode 0600.
#
# Sourced by /usr/local/sbin/chesstrainer-probe. The check-in URL is a secret:
# anyone who has it can mark the check green, so keep it out of the repo and
# out of world-readable files.

# The public URL a visitor actually requests. Probing the edge rather than
# loopback is deliberate: DNS, TLS, Cloudflare, Caddy and the origin allowlist
# are part of the contract. Must be https.
PROBE_URL=https://innersquare.app/health

# healthchecks.io ping URL for the two-minute probe check. A healthy run posts
# to it; a failed run posts to <url>/fail.
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# The tablebase value /health should report. "local" means Syzygy files are
# loaded, "fallback" means Lichess is used, "not_configured" means
# TABLEBASE_PATH is unset. A mismatch is reported as degraded, never as down.
# Set to "any" to accept whatever the app reports.
EXPECT_TABLEBASE=local

# Whole-request timeout. The timer runs every two minutes, so keep this well
# under that.
PROBE_TIMEOUT_SECONDS=10

# Loopback health URL. It is consulted only when the public probe fails, and
# only as evidence: it does not change the verdict. Defaults to the value shown.
# ORIGIN_URL=http://127.0.0.1:4100/health
