<Layouts.flash_group flash={@flash} />
<main id="main-content" tabindex="-1">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">
        <.icon_spark /> Chess Endgames, simplified
      </div>
      <h1>
        Master chess <em>endgames.</em>
      </h1>
      <p>
        Train your intuition to find the winning moves under pressure. Puzzle sessions focused purely on technical execution.
      </p>
      <div class="hero-actions">
        <%= if @active_endgame do %>
          <.pill_button variant={:primary} navigate={play_path(@active_endgame)}>
            Try today's puzzle <.icon_arrow />
          </.pill_button>
        <% else %>
          <.pill_button variant={:primary} navigate={play_path(nil)}>
            Start training <.icon_arrow />
          </.pill_button>
        <% end %>
        <div class="rating-note">
          <span class="avatar-stack">
            <i>♟</i>
            <i>♙</i>
            <i>♜</i>
          </span>
          <span>
            <strong>{count_label(@logged_in_count)}</strong> players training
          </span>
        </div>
      </div>
    </div>
    <div class="board-stage" id="trainer">
      <div class="coral-orbit" />
      <div class="mint-orbit" />
      <.board_preview endgame={@active_endgame} date={@today} />
    </div>
  </section>

  <section class="learning-strip" id="method">
    <figure class="learning-quote">
      <blockquote>“The hardest game to win is a won game.”</blockquote>
      <figcaption>— Emmanuel Lasker</figcaption>
    </figure>
    <div class="stat">
      <strong>{count_label(@puzzle_count)}</strong>
      <span>puzzles</span>
    </div>
    <div class="stat">
      <strong>{@user_count}</strong>
      <span>Players improving their endgame</span>
    </div>
  </section>

  <section class="puzzle-section" id="puzzles">
    <div class="section-heading">
      <div>
        <span class="section-kicker">Choose your lesson</span>
        <h2>
          One position. <br /> One idea.
        </h2>
      </div>
      <p>
        Each exercise teaches a pattern
        that you’ll recognise over the board.
      </p>
    </div>
    <div class="puzzle-coming-soon">
      <div class="eyebrow">
        <.icon_spark /> Coming soon
      </div>
      <strong>The lesson library is on its way.</strong>
      <p>
        A growing set of positions, each teaching one idea. Today’s puzzle is already live.
      </p>
    </div>
  </section>

  <.mailing_list_signup :if={@mailing_list_enabled} />

  <%!-- <section class="progress-banner" id="progress">
    <div>
      <span class="section-kicker">A calmer way to improve</span>
      <h2>
        Make the endgame <br /> your strongest phase.
      </h2>
    </div>
    <.pill_button variant={:light} navigate={play_path(@active_endgame)}>
      Begin with the basics <.icon_arrow />
    </.pill_button>
  </section> --%>
</main>
