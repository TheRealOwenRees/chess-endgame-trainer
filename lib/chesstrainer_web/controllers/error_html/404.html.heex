<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{Branding.title("Page not found")}</title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link
      rel="preload"
      href="/fonts/dm-sans-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-serif-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/marketing.js"}>
    </script>
    <Layouts.theme_script />
  </head>
  <body>
    <Layouts.navbar current_scope={assigns[:current_scope]} />

    <.error_page
      status={404}
      title="This page isn't on the board"
      message="The page you were looking for moved, or never existed. Check the address, or head back to the trainer."
      current_scope={assigns[:current_scope]}
    />

    <Layouts.footer />
  </body>
</html>
